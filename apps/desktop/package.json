{
  "name": "@haired/desktop",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Haired protected desktop screen assistant",
  "main": "./out/main/index.js",
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "postinstall": "electron-builder install-app-deps",
    "predev": "electron-vite build",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:preview": "pnpm build && electron-builder --config electron-builder.preview.yml --publish never",
    "dist:publish": "pnpm build && electron-builder --publish always",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src electron.vite.config.ts --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@haired/contracts": "workspace:*",
    "@lobehub/icons-static-svg": "^1.94.0",
    "better-sqlite3": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.525.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.0.4"
  }
}
